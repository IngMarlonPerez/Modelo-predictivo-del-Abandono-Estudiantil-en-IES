{
  "name": "vicmar-alerta-temprana",
  "version": "3.0.0",
  "private": true,
  "description": "Interfaz web del prototipo para predecir el abandono estudiantil con aprendizaje automático y consulta conversacional (UNEMI, 2026)",
  "author": "Marlon David Pérez Almachi y Víctor Manuel Lluilema Pisco",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:backend": "cd ..\\backend && venv\\Scripts\\python.exe -m uvicorn main:app --reload --port 8090",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 3000",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/react-query": "^5.104.1",
    "react": "^18.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^6.30.6",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^1.6.1"
  }
}
