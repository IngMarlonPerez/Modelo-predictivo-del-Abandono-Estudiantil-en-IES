# ── Configuración del backend (Python/FastAPI) ─────────────────────────────
# Sistema web de alerta temprana del abandono estudiantil con aprendizaje
# automático y consulta conversacional.
#
# Copie este archivo como ".env" en esta misma carpeta (backend)
# y complete los valores. El archivo .env nunca se sube al repositorio.
# Paso a paso: documentacion/manuales/MANUAL_TECNICO_DE_INSTALACION.md
#
# El orquestador (python -m scripts.pipeline) agrega por su cuenta las
# variables que falten de la versión 3 (contraseña de app_seguimiento, llave
# JWT), sin mostrarlas en pantalla.
#
# Autores: Marlon David Pérez Almachi, Víctor Manuel Lluilema Pisco
# Proyecto de titulación · Universidad Estatal de Milagro · 2026

APP_ENV=development

# ── SQL Server ──────────────────────────────────────────────────────────────
# Contenedor Docker del proyecto (ver el manual técnico, sección «Base de
# datos»). DB_USER/DB_PASSWORD es la cuenta de administración que usan SOLO
# los procesos por lotes (carga, ETL, entrenamiento, calificación). La API
# nunca lee con ella.
DB_HOST=localhost,1433
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_USER=sa
DB_PASSWORD=
ALMACEN_DB=ALMACEN_ACADEMICO

# Cuenta de SOLO LECTURA: puede leer únicamente las vistas VIS_* del almacén,
# que filtran por la institución activa. Todas las lecturas de la API y el
# SQL de la consulta conversacional se ejecutan con ella.
CHAT_READER_USER=chat_reader
CHAT_READER_PASSWORD=

# Cuenta de seguimiento: solo puede EJECUTAR los dos procedimientos que
# registran y cierran intervenciones de bienestar estudiantil.
APP_SEGUIMIENTO_USER=app_seguimiento
APP_SEGUIMIENTO_PASSWORD=

# Tiempo máximo de una consulta a la base (segundos).
TIEMPO_MAXIMO_CONSULTA_S=30

# ── API / CORS ──────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Seguridad (JWT) ─────────────────────────────────────────────────────────
# APP_ENV=production impide arrancar con la llave de desarrollo. Para generar
# una llave larga y aleatoria:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Cuentas de usuario ──────────────────────────────────────────────────────
# Por defecto viven en backend/datos_locales/usuarios.json (fuera del
# repositorio). Si el almacén está vacío y se definen estas dos variables, se
# crea la primera cuenta ADMIN_TI al arrancar; después conviene retirarlas.
# Las cuentas de demostración por rol se crean con:
#   python -m scripts.crear_usuarios_demo
ADMIN_INICIAL_USUARIO=
ADMIN_INICIAL_CLAVE=

# ── Consulta conversacional: cascada de proveedores de IA ──────────────────
# Se intentan en orden: Gemini → Groq → NVIDIA NIM → DeepSeek. Bastan las
# claves gratuitas; DeepSeek (de pago) es opcional. Sin ninguna clave, las 40
# métricas certificadas siguen respondiendo y el resto del sistema funciona.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
NVIDIA_API_KEY=
NVIDIA_MODEL=moonshotai/kimi-k3
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# Temperatura 0: el SQL debe ser reproducible.
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1600
TIEMPO_MAXIMO_LLM_S=45
